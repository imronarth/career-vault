# PostgreSQL configuration
POSTGRES_DB=careervault
POSTGRES_USER=careervault
POSTGRES_PASSWORD=replace-with-strong-db-password

# Initial admin account (seeded once when user_accounts is empty)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-strong-admin-password

# Time zone for dates and times shown by the app
APP_TIMEZONE=Asia/Jakarta

# Host binding for rootless Podman port forwarding
APP_BIND_IP=0.0.0.0
APP_PORT=8080
